        "jsCode": "const pasta = $json;\nconst nome = pasta.name ?? '';\nconst m = nome.match(/^(.*?)\\s*-\\s*(\\d{4})\\/(\\d{2})\\/(\\d{2})\\s+(\\d{2}):(\\d{2})\\s+GMT([+-]\\d{2}):?(\\d{2})\\s*$/);\nconst titulo = (m ? m[1] : nome).trim();\nconst inicioReuniao = m\n  ? `${m[2]}-${m[3]}-${m[4]}T${m[5]}:${m[6]}:00${m[7]}:${m[8]}`\n  : (pasta.createdTime ?? $now.toISO());\nreturn { json: { pastaId: pasta.id, pastaNome: nome, titulo, inicioReuniao } };"
