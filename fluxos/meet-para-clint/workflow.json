        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Extrair dados do título').item.json;\nconst arquivos = $('Listar arquivos da reunião').item.json.files ?? [];\nconst eventos = $json.items ?? [];\nconst docs = arquivos.filter((f) => f.mimeType === 'application/vnd.google-apps.document');\nconst doc = docs.find((f) => /Anota[çc][õo]es do Gemini|Notes by Gemini/i.test(f.name))\n  ?? docs.find((f) => /Transcri[çc][ãa]o|Transcript/i.test(f.name))\n  ?? docs[0]\n  ?? null;\nconst norm = (s) => (s ?? '').toLowerCase().replace(/\\s+/g, ' ').trim();\nconst evento = eventos.find((e) => norm(e.summary) === norm(ctx.titulo)) ?? null;\nconst dealId = (evento?.description ?? '')\n  .match(/(?:clint\\.digital|useclint\\.com)\\/deal\\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i)?.[1] ?? null;\nreturn { json: {\n  ...ctx,\n  docId: doc?.id ?? null,\n  docNome: doc?.name ?? null,\n  docUrl: doc ? (doc.webViewLink ?? `https://docs.google.com/document/d/${doc.id}`) : null,\n  eventoId: evento?.id ?? null,\n  dealId,\n} };"
      },
