      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const CAMPO = 'notas_da_reuniao';\nconst ctx = $('Achou deal?').item.json;\nconst acharIa = (v) => {\n  if (typeof v === 'string') {\n    const s = v.trim();\n    if (!s.startsWith('{')) return null;\n    try { return acharIa(JSON.parse(s)); } catch (e) { return null; }\n  }\n  if (Array.isArray(v)) {\n    for (const x of v) { const r = acharIa(x); if (r) return r; }\n    return null;\n  }\n  if (v && typeof v === 'object') {\n    if ('tipo_mao_de_obra' in v) return v;\n    for (const x of Object.values(v)) { const r = acharIa(x); if (r) return r; }\n  }\n  return null;\n};\nconst ia = acharIa($json);\nif (!ia) throw new Error('Resposta da IA sem os campos esperados');\nconst esc = (s) => String(s ?? 'Não mencionado')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  .replace(/\\n/g, '<br>');\nconst data = DateTime.fromISO(ctx.inicioReuniao).setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy HH:mm');\nconst itens = [\n  ['Mão de obra', ia.tipo_mao_de_obra],\n  ['Recibo', ia.consegue_recibo],\n  ['Valores', ia.negociacao_valores],\n  ['Pagamento', ia.negociacao_forma_pagamento],\n  ['Objeção', ia.objecao_decisao],\n  ['Retorno', ia.dia_retorno],\n];\nconst bloco = `<p><strong>📅 Reunião ${data}</strong></p>`\n  + `<p>${itens.map(([rotulo, valor]) => `• <strong>${rotulo}:</strong> ${esc(valor)}`).join('<br>')}</p>`\n  + `<p><strong>Resumo:</strong> ${esc(ia.resumo)}</p>`\n  + `<p><a href=\"${ctx.docUrl}\">Ver transcrição</a></p>`;\nconst atual = ctx.deal?.fields?.[CAMPO] ?? '';\nconst atualVazio = atual.replace(/<[^>]*>|&nbsp;|\\s/g, '') === '';\nconst jaGravado = !atualVazio && atual.includes(ctx.docId);\nconst html = atualVazio ? bloco : `${bloco}<p>────────────</p>${atual}`;\nconst htmlAscii = html.replace(/[^\\x00-\\x7F]/gu, (c) => `&#${c.codePointAt(0)};`);\nreturn { json: {\n  dealId: ctx.deal.id,\n  jaGravado,\n  corpo: { fields: { [CAMPO]: htmlAscii } },\n} };"
      },
