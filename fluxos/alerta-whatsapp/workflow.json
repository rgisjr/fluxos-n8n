    {
      "id": "2dc8adc6-acf3-4997-aee0-77c3c728818b",
      "name": "Anti-spam 30 min",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const JANELA_MS = 30 * 60 * 1000;\nconst estado = $getWorkflowStaticData('global');\nconst agora = Date.now();\nconst recentes = Object.fromEntries(\n  Object.entries(estado.enviados ?? {}).filter(([, t]) => agora - t < JANELA_MS),\n);\nconst item = $input.first().json;\nif (recentes[item.chave]) {\n  estado.enviados = recentes;\n  return [];\n}\nestado.enviados = { ...recentes, [item.chave]: agora };\nreturn [{ json: item }];"
      }
    },
