      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const e = $input.first().json;\nconst mensagem = (e.execution?.error?.message ?? '?').slice(0, 300);\nconst linhas = [\n  '⚠️ Falha no n8n',\n  `Fluxo: ${e.workflow?.name ?? '?'}`,\n  `Passo: ${e.execution?.lastNodeExecuted ?? '?'}`,\n  `Erro: ${mensagem}`,\n  `Quando: ${DateTime.now().setZone('America/Sao_Paulo').toFormat('dd/MM HH:mm')}`,\n  e.execution?.url ? `Ver execução: ${e.execution.url}` : '',\n];\nreturn [{ json: {\n  tipo: 'erro',\n  chave: `${e.workflow?.id}:${mensagem}`,\n  texto: linhas.filter(Boolean).join('\\n'),\n} }];"
      }
    },
